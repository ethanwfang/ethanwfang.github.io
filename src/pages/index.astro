---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { projects } from '../data/projects';
import { gallery } from '../data/gallery';
import { research } from '../data/research';
import { work } from '../data/work';
---

<Base title="Ethan Fang">
  <section class="hero">
    <div class="hero__inner">
      <img
        src="/calligraphy.png"
        alt="Chinese name"
        class="chop"
      />
      <h1 class="name">Ethan Fang</h1>
      <div class="bio">
        <p>Based out of the Bay Area. I spend most of my time in math modeling, AI research, and engineering.</p>
        <p>I graduated in 4 years from Case Western Reserve University in May 2026 with a dual BS/MS degree in computer science. During my time there, I cofounded the quant finance club, grew the tennis club to record participation, and did lots of research.</p>
        <p>Currently, I am a Software Engineer at Fluency, where we are building a work ontology to automate processes in enterprise companies. Previously, I was a quantitative analyst at KeyBank for 1.5 years, where I worked on statistically-backed sequential feature selection, distributed computing, and backtesting for the modeling codebase used by the quants at the bank.</p>
        <figure class="snapshot">
          <picture>
            <source srcset="/yc.webp" type="image/webp" />
            <img
              src="/yc.jpg"
              alt="Ethan Fang standing beside a large orange Y Combinator sign in San Francisco"
              width="1400"
              height="1457"
              loading="lazy"
              decoding="async"
              class="snapshot__img"
            />
          </picture>
          <figcaption class="snapshot__caption">YC Startup School 2026</figcaption>
        </figure>
        <p>I am passionate about researching and building technologies that create meaningful real-world impact. My interests include sustainability, human-centered AI, and athletic performance. In my free time, I read about game theory, do research on differential equations, and teach tennis to competitive juniors in my hometown.</p>
      </div>
    </div>
  </section>

  <section class="previously container">
    <div class="previously__inner">
      <h2 class="previously__title">Previously</h2>
      <p class="previously__body">
        I was a nationally ranked junior tennis player, and a California All-State violinist for 6 consecutive years.
      </p>
    </div>
  </section>

  <section class="page container">
    <div class="tabs" role="tablist" aria-label="Sections">
      <button class="tab is-active" role="tab" type="button" id="tab-work" aria-controls="panel-work" aria-selected="true" data-tab="work">Work</button>
      <button class="tab" role="tab" type="button" id="tab-research" aria-controls="panel-research" aria-selected="false" tabindex="-1" data-tab="research">Research</button>
      <button class="tab" role="tab" type="button" id="tab-projects" aria-controls="panel-projects" aria-selected="false" tabindex="-1" data-tab="projects">Projects</button>
      <button class="tab" role="tab" type="button" id="tab-gallery" aria-controls="panel-gallery" aria-selected="false" tabindex="-1" data-tab="gallery">Gallery</button>
    </div>

    <div class="panel" id="panel-work" role="tabpanel" aria-labelledby="tab-work" data-panel="work">
    <ol class="entry-list">
      {work.map((w) => {
        const external = w.href && w.href.startsWith('http');
        const hasBlogPost = !!w.blogPost;
        const Tag = w.href && !hasBlogPost ? 'a' : 'div';
        return (
          <li class="entry entry--work">
            <Tag
              class="entry__link"
              href={!hasBlogPost ? w.href : undefined}
              target={!hasBlogPost && external ? '_blank' : undefined}
              rel={!hasBlogPost && external ? 'noopener noreferrer' : undefined}
            >
              <Logo domain={w.domain} mark={w.mark} alt={w.org} />
              <div class="entry__body">
                <div class="entry__head">
                  {hasBlogPost && w.href ? (
                    <a
                      class="entry__title-link"
                      href={w.href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                    >
                      <h3 class="entry__title">
                        {w.org}<span class="entry__sep"> · </span><span class="entry__sub">{w.role}</span>
                      </h3>
                    </a>
                  ) : (
                    <h3 class="entry__title">
                      {w.org}<span class="entry__sep"> · </span><span class="entry__sub">{w.role}</span>
                    </h3>
                  )}
                  <div class="entry__aside">
                    <span class="entry__meta">{w.period}</span>
                    <span class={`entry__arrow${w.href ? '' : ' entry__arrow--hidden'}`} aria-hidden="true">↗</span>
                  </div>
                </div>
                {w.blogPost && (
                  <a href={w.blogPost} class="entry__blog-btn">blog post ↗</a>
                )}
              </div>
            </Tag>
          </li>
        );
      })}
    </ol>

    </div>

    <div class="panel" id="panel-research" role="tabpanel" aria-labelledby="tab-research" data-panel="research" hidden>
    <ol class="entry-list">
      {research.map((r) => {
        const Tag = r.href ? 'a' : 'div';
        return (
          <li class="entry">
            <Tag
              class="entry__link entry__link--project"
              href={r.href}
              target={r.href ? '_blank' : undefined}
              rel={r.href ? 'noopener noreferrer' : undefined}
            >
              <div class="entry__body">
                <div class="entry__head">
                  <h3 class="entry__title">{r.title}</h3>
                  <div class="entry__aside">
                    <span class="entry__meta">{r.year}</span>
                    <span class={`entry__arrow${r.href ? '' : ' entry__arrow--hidden'}`} aria-hidden="true">↗</span>
                  </div>
                </div>
                <p class="entry__blurb">{r.blurb}</p>
              </div>
            </Tag>
          </li>
        );
      })}
    </ol>

    </div>

    <div class="panel" id="panel-projects" role="tabpanel" aria-labelledby="tab-projects" data-panel="projects" hidden>
    <ol class="entry-list">
      {projects.map((p) => {
        const hasInlineLinks = !!p.blurbHtml || !!p.demoVideo;
        const Tag = (p.href && !hasInlineLinks) ? 'a' : 'div';
        return (
          <li class="entry">
            <Tag
              class="entry__link entry__link--project"
              href={!hasInlineLinks ? p.href : undefined}
              target={!hasInlineLinks && p.href ? '_blank' : undefined}
              rel={!hasInlineLinks && p.href ? 'noopener noreferrer' : undefined}
            >
              <div class="entry__body">
                <div class="entry__head">
                  {hasInlineLinks && p.href ? (
                    <>
                      <a class="entry__title-link" href={p.href} target="_blank" rel="noopener noreferrer">
                        <h3 class="entry__title">{p.title}</h3>
                      </a>
                      <div class="entry__aside">
                        <span class="entry__meta">{p.year}</span>
                        <span class="entry__arrow" aria-hidden="true">↗</span>
                      </div>
                    </>
                  ) : (
                    <>
                      <h3 class="entry__title">{p.title}</h3>
                      <div class="entry__aside">
                        <span class="entry__meta">{p.year}</span>
                        <span class={`entry__arrow${p.href ? '' : ' entry__arrow--hidden'}`} aria-hidden="true">↗</span>
                      </div>
                    </>
                  )}
                </div>
                {p.blurbHtml
                  ? <p class="entry__blurb"><Fragment set:html={p.blurbHtml} /></p>
                  : <p class="entry__blurb">{p.blurb}</p>
                }
                {p.blogPost && (
                  <a href={p.blogPost} class="entry__blog-btn">blog post ↗</a>
                )}
                {p.demoVideo && (
                  <a href={p.demoVideo} target="_blank" rel="noopener noreferrer" class="entry__blog-btn">demo ↗</a>
                )}
              </div>
            </Tag>
          </li>
        );
      })}
    </ol>
    </div>

    <div class="panel" id="panel-gallery" role="tabpanel" aria-labelledby="tab-gallery" data-panel="gallery" hidden>
      <ul class="grid">
        {gallery.length === 0 && [0, 1, 2].map(() => (
          <li class="grid__cell grid__cell--empty" aria-hidden="true"></li>
        ))}
        {gallery.map((photo, i) => (
          <li class="grid__cell">
            <button class="grid__btn" type="button" data-photo={i} aria-label={`Open photo ${i + 1} of ${gallery.length}`}>
              <picture>
                {photo.webp && <source srcset={photo.webp} type="image/webp" />}
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                  class="grid__img"
                />
              </picture>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
    <button class="lightbox__close" type="button" data-close aria-label="Close">&times;</button>
    <button class="lightbox__nav lightbox__nav--prev" type="button" data-step="-1" aria-label="Previous photo">&#8249;</button>
    <img class="lightbox__img" id="lightbox-img" src="" alt="" />
    <button class="lightbox__nav lightbox__nav--next" type="button" data-step="1" aria-label="Next photo">&#8250;</button>
  </dialog>
</Base>

<style>
  .hero {
    padding: 6rem 0 2rem;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 1.25rem;
    width: min(100% - 2.5rem, 640px);
    margin-inline: auto;
  }
  .chop {
    width: clamp(220px, 60%, 420px);
    height: auto;
    opacity: 0.95;
    filter: drop-shadow(0 10px 30px color-mix(in srgb, var(--accent) 22%, transparent));
    mix-blend-mode: multiply;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-3);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0;
  }
  .bio {
    margin-top: 0.5rem;
    font-size: var(--step-0);
    line-height: 1.55;
    max-width: 56ch;
    color: var(--ink);
  }
  .bio p { margin: 0 0 0.8em; }
  .bio p:last-child { margin-bottom: 0; }

  .previously { padding: 0; }
  .previously__inner {
    width: min(100% - 2.5rem, 640px);
    margin-inline: auto;
  }
  .previously__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--step-0);
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
  }
  .previously__body {
    font-size: var(--step-0);
    line-height: 1.55;
    max-width: 56ch;
    color: var(--ink);
    margin: 0;
  }
  .previously__body a { background-image: none; text-decoration: underline; }

  .snapshot {
    margin: 1.6rem auto;
    text-align: center;
  }
  .snapshot__img {
    display: block;
    width: clamp(160px, 42%, 260px);
    height: auto;
    margin-inline: auto;
    border-radius: 2px;
    filter: drop-shadow(0 10px 30px color-mix(in srgb, var(--accent) 14%, transparent));
  }
  .snapshot__caption {
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .page { padding: 2rem 0 4rem; font-size: 0.8rem; width: min(100% - 2.5rem, 640px); margin-inline: auto; }

  .tabs {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin: 0 0 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .tab {
    appearance: none;
    background: none;
    border: 0;
    padding: 0 0 0.6rem;
    margin: 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-1);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--muted);
    position: relative;
    transition: color 200ms ease;
  }
  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }
  .tab:hover { color: var(--ink); }
  .tab.is-active { color: var(--ink); }
  .tab.is-active::after { transform: scaleX(1); }
  .tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }

  .panel[hidden] { display: none; }
  .panel { animation: panel-in 220ms ease both; }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel { animation: none; }
    .tab::after { transition: none; }
  }

  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .entry { border-bottom: 1px solid var(--rule); }
  .entry__link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 0;
    background-image: none;
    color: var(--ink);
    transition: color 200ms ease;
  }
  .entry__link--project { align-items: flex-start; }
  .entry__link--project { padding-left: 0; }
  .entry__link:hover { color: var(--accent); }
  .entry__link:hover .entry__arrow { transform: translate(3px, -3px); color: var(--accent); }
  .entry__title-link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    background-image: none;
    color: inherit;
    transition: color 200ms ease;
  }
  .entry__title-link:hover { color: var(--accent); }
  .entry__title-link:hover .entry__arrow { transform: translate(3px, -3px); color: var(--accent); }
  .entry__blurb a { background-image: none; text-decoration: underline; }

  .entry__body { flex: 1; min-width: 0; }
  .entry__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .entry__link--project .entry__head { margin-bottom: 0.2rem; }
  .entry__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.3;
    min-width: 0;
  }
  .entry__sep { color: var(--muted); font-style: italic; }
  .entry__sub { color: var(--muted); font-style: italic; }

  .entry__aside {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-shrink: 0;
    color: var(--muted);
  }
  .entry__meta {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .entry__arrow {
    font-size: 0.9rem;
    transition: transform 250ms ease, color 200ms ease;
    display: inline-block;
  }
  .entry__arrow--hidden { visibility: hidden; }

  .entry--work .entry__title {
    font-size: clamp(0.85rem, 0.8rem + 0.2vw, 0.95rem);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .entry__blurb {
    color: var(--muted);
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    line-height: 1.55;
    max-width: 72ch;
  }

  .entry__blog-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.55rem;
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 100px;
    color: var(--muted);
    background-image: none;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .entry__blog-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
  }
  .grid__cell--empty {
    aspect-ratio: 1;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: color-mix(in srgb, var(--paper-2) 60%, transparent);
  }
  .grid__btn {
    appearance: none;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: 2px;
    overflow: hidden;
  }
  .grid__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .grid__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    transition: opacity 200ms ease, transform 300ms ease;
  }
  .grid__btn:hover .grid__img { opacity: 0.86; transform: scale(1.02); }

  .lightbox {
    border: 0;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    background: transparent;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .lightbox[open] { display: flex; }
  .lightbox::backdrop { background: color-mix(in srgb, #14110d 88%, transparent); }
  .lightbox__img {
    max-width: min(92vw, 1100px);
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2px;
  }
  .lightbox__close,
  .lightbox__nav {
    appearance: none;
    background: none;
    border: 0;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    color: #f7f3ec;
    opacity: 0.7;
    line-height: 1;
    transition: opacity 180ms ease;
  }
  .lightbox__close:hover,
  .lightbox__nav:hover { opacity: 1; }
  .lightbox__close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: 2rem;
  }
  .lightbox__nav { font-size: 2.5rem; }
  .lightbox__nav[hidden] { visibility: hidden; display: block; }

  @media (max-width: 560px) {
    .lightbox__nav { font-size: 2rem; padding: 0.25rem 0.2rem; }
  }

  @media (max-width: 560px) {
    .entry__head { flex-wrap: wrap; gap: 0.3rem 1rem; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

  function select(name: string, focus = false) {
    tabs.forEach((tab) => {
      const active = tab.dataset.tab === name;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && focus) tab.focus();
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== name;
    });
    history.replaceState(null, '', name === 'work' ? location.pathname : `#${name}`);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => select(tab.dataset.tab!));
    tab.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(tab);
      let next = -1;
      if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      if (e.key === 'Home') next = 0;
      if (e.key === 'End') next = tabs.length - 1;
      if (next < 0) return;
      e.preventDefault();
      select(tabs[next].dataset.tab!, true);
    });
  });

  const initial = location.hash.slice(1);
  if (tabs.some((t) => t.dataset.tab === initial)) select(initial);

  const photos = Array.from(document.querySelectorAll<HTMLImageElement>('.grid__img'));
  const lightbox = document.querySelector<HTMLDialogElement>('#lightbox');
  const lightboxImg = document.querySelector<HTMLImageElement>('#lightbox-img');

  if (lightbox && lightboxImg && photos.length) {
    const navs = Array.from(lightbox.querySelectorAll<HTMLButtonElement>('.lightbox__nav'));
    let current = 0;

    function show(i: number) {
      current = (i + photos.length) % photos.length;
      const photo = photos[current];
      lightboxImg!.src = photo.currentSrc || photo.src;
      lightboxImg!.alt = photo.alt;
      navs.forEach((nav) => { nav.hidden = photos.length < 2; });
    }

    document.querySelectorAll<HTMLButtonElement>('.grid__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.photo));
        lightbox.showModal();
      });
    });

    navs.forEach((nav) => {
      nav.addEventListener('click', (e) => {
        e.stopPropagation();
        show(current + Number(nav.dataset.step));
      });
    });

    lightbox.querySelector<HTMLButtonElement>('[data-close]')?.addEventListener('click', () => lightbox.close());

    // Click anywhere outside the image closes.
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === lightboxImg) lightbox.close();
    });

    lightbox.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
    });

    lightbox.addEventListener('close', () => { lightboxImg.src = ''; });
  }
</script>
