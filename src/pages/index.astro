---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { projects } from '../data/projects';
import { gallery } from '../data/gallery';
import { research } from '../data/research';
import { work } from '../data/work';
---

<Base title="Ethan Fang">
  <section class="hero container">
    <img src="/calligraphy.png" alt="Chinese name" class="chop" />
    <h1 class="name">ethan fang</h1>

    <div class="bio">
      <p>I graduated in 4 years from Case Western Reserve University in May 2026 with a dual BS/MS degree in computer science. During my time there, I cofounded the quant finance club, grew the tennis club to record participation, and did lots of research.</p>
      <p>Currently, I am a Software Engineer at Fluency, where we are building a work ontology to automate processes in enterprise companies. Previously, I was a quantitative analyst at KeyBank for 1.5 years, where I worked on statistically-backed sequential feature selection, distributed computing, and backtesting for the modeling codebase used by the quants at the bank.</p>

      <div class="media-row">
        <figure class="snapshot box">
          <picture>
          <source srcset="/yc.webp" type="image/webp" />
          <img
            src="/yc.jpg"
            alt="Ethan Fang standing beside a large orange Y Combinator sign in San Francisco"
            width="1400"
            height="1457"
            loading="lazy"
            decoding="async"
            class="snapshot__img"
          />
        </picture>
        <figcaption class="panel-caption">YC Startup School 2026</figcaption>
      </figure>

        <figure class="sprite">
          <img
            src="/naruto.gif"
            alt="Animated pixel art sprite of Naruto cloaked in red chakra"
            width="300"
            height="300"
            loading="lazy"
            decoding="async"
            class="sprite__img"
          />
          <figcaption class="sprite__credit">
            <a href="https://www.deviantart.com/narudraw312/art/Naruto-Sprite-animation-1-106687063" target="_blank" rel="noopener noreferrer">Naruto Sprite animation 1 &mdash; narudraw312<span aria-hidden="true"> &#8599;</span></a>
          </figcaption>
        </figure>
      </div>

      <p>I am passionate about researching and building technologies that create meaningful real-world impact. My interests include sustainability, human-centered AI, and athletic performance.</p>
    </div>
  </section>

  <section class="previously container">
    <h2 class="label">previously</h2>
    <p class="previously__body">
      I was a nationally ranked junior tennis player, and a California All-State violinist for 6 consecutive years.
    </p>
  </section>

  <section class="page container">
    <div class="tabs" role="tablist" aria-label="Sections">
      <button class="tab is-active" role="tab" type="button" id="tab-work" aria-controls="panel-work" aria-selected="true" data-tab="work">Work</button>
      <button class="tab" role="tab" type="button" id="tab-research" aria-controls="panel-research" aria-selected="false" tabindex="-1" data-tab="research">Research</button>
      <button class="tab" role="tab" type="button" id="tab-projects" aria-controls="panel-projects" aria-selected="false" tabindex="-1" data-tab="projects">Projects</button>
      <button class="tab" role="tab" type="button" id="tab-gallery" aria-controls="panel-gallery" aria-selected="false" tabindex="-1" data-tab="gallery">Gallery</button>
    </div>

    <div class="panel" id="panel-work" role="tabpanel" aria-labelledby="tab-work" data-panel="work">
    <ol class="entry-list box">
      {work.map((w) => {
        const external = w.href && w.href.startsWith('http');
        const hasBlogPost = !!w.blogPost;
        const Tag = w.href && !hasBlogPost ? 'a' : 'div';
        return (
          <li class="entry entry--work">
            <Tag
              class="entry__link"
              href={!hasBlogPost ? w.href : undefined}
              target={!hasBlogPost && external ? '_blank' : undefined}
              rel={!hasBlogPost && external ? 'noopener noreferrer' : undefined}
            >
              <Logo domain={w.domain} mark={w.mark} alt={w.org} />
              <div class="entry__body">
                <div class="entry__head">
                  {hasBlogPost && w.href ? (
                    <a
                      class="entry__title-link"
                      href={w.href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                    >
                      <h3 class="entry__title">
                        {w.org}<span class="entry__sep"> · </span><span class="entry__sub">{w.role}</span>
                      </h3>
                    </a>
                  ) : (
                    <h3 class="entry__title">
                      {w.org}<span class="entry__sep"> · </span><span class="entry__sub">{w.role}</span>
                    </h3>
                  )}
                  <div class="entry__aside">
                    <span class="entry__meta">{w.period}</span>
                    <span class={`entry__arrow${w.href ? '' : ' entry__arrow--hidden'}`} aria-hidden="true">↗</span>
                  </div>
                </div>
                {w.blogPost && (
                  <a href={w.blogPost} class="entry__blog-btn">blog post ↗</a>
                )}
              </div>
            </Tag>
          </li>
        );
      })}
    </ol>

    </div>

    <div class="panel" id="panel-research" role="tabpanel" aria-labelledby="tab-research" data-panel="research" hidden>
    <ol class="entry-list box">
      {research.map((r) => {
        const Tag = r.href ? 'a' : 'div';
        return (
          <li class="entry">
            <Tag
              class="entry__link entry__link--project"
              href={r.href}
              target={r.href ? '_blank' : undefined}
              rel={r.href ? 'noopener noreferrer' : undefined}
            >
              <div class="entry__body">
                <div class="entry__head">
                  <h3 class="entry__title">{r.title}</h3>
                  <div class="entry__aside">
                    <span class="entry__meta">{r.year}</span>
                    <span class={`entry__arrow${r.href ? '' : ' entry__arrow--hidden'}`} aria-hidden="true">↗</span>
                  </div>
                </div>
                <p class="entry__blurb">{r.blurb}</p>
              </div>
            </Tag>
          </li>
        );
      })}
    </ol>

    </div>

    <div class="panel" id="panel-projects" role="tabpanel" aria-labelledby="tab-projects" data-panel="projects" hidden>
    <ol class="entry-list box">
      {projects.map((p) => {
        const hasInlineLinks = !!p.blurbHtml || !!p.demoVideo;
        const Tag = (p.href && !hasInlineLinks) ? 'a' : 'div';
        return (
          <li class="entry">
            <Tag
              class="entry__link entry__link--project"
              href={!hasInlineLinks ? p.href : undefined}
              target={!hasInlineLinks && p.href ? '_blank' : undefined}
              rel={!hasInlineLinks && p.href ? 'noopener noreferrer' : undefined}
            >
              <div class="entry__body">
                <div class="entry__head">
                  {hasInlineLinks && p.href ? (
                    <>
                      <a class="entry__title-link" href={p.href} target="_blank" rel="noopener noreferrer">
                        <h3 class="entry__title">{p.title}</h3>
                      </a>
                      <div class="entry__aside">
                        <span class="entry__meta">{p.year}</span>
                        <span class="entry__arrow" aria-hidden="true">↗</span>
                      </div>
                    </>
                  ) : (
                    <>
                      <h3 class="entry__title">{p.title}</h3>
                      <div class="entry__aside">
                        <span class="entry__meta">{p.year}</span>
                        <span class={`entry__arrow${p.href ? '' : ' entry__arrow--hidden'}`} aria-hidden="true">↗</span>
                      </div>
                    </>
                  )}
                </div>
                {p.blurbHtml
                  ? <p class="entry__blurb"><Fragment set:html={p.blurbHtml} /></p>
                  : <p class="entry__blurb">{p.blurb}</p>
                }
                {p.blogPost && (
                  <a href={p.blogPost} class="entry__blog-btn">blog post ↗</a>
                )}
                {p.demoVideo && (
                  <a href={p.demoVideo} target="_blank" rel="noopener noreferrer" class="entry__blog-btn">demo ↗</a>
                )}
              </div>
            </Tag>
          </li>
        );
      })}
    </ol>
    </div>

    <div class="panel" id="panel-gallery" role="tabpanel" aria-labelledby="tab-gallery" data-panel="gallery" hidden>
      <ul class="grid">
        {gallery.length === 0 && [0, 1, 2].map(() => (
          <li class="grid__cell grid__cell--empty" aria-hidden="true"></li>
        ))}
        {gallery.map((photo, i) => (
          <li class="grid__cell">
            <button class="grid__btn" type="button" data-photo={i} aria-label={`Open photo ${i + 1} of ${gallery.length}`}>
              <picture>
                {photo.webp && <source srcset={photo.webp} type="image/webp" />}
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                  class="grid__img"
                />
              </picture>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
    <button class="lightbox__close" type="button" data-close aria-label="Close">&times;</button>
    <button class="lightbox__nav lightbox__nav--prev" type="button" data-step="-1" aria-label="Previous photo">&#8249;</button>
    <img class="lightbox__img" id="lightbox-img" src="" alt="" />
    <button class="lightbox__nav lightbox__nav--next" type="button" data-step="1" aria-label="Next photo">&#8250;</button>
  </dialog>
</Base>

<style>
  /* ---- hero ---------------------------------------------------------- */
  .hero {
    padding: 4rem 0 3rem;
    max-width: 720px;
  }
  .chop {
    width: clamp(180px, 45%, 300px);
    height: auto;
    display: block;
    margin-bottom: 1.5rem;
    mix-blend-mode: multiply;
  }
  .name {
    font-size: clamp(2.125rem, 1.7rem + 2.1vw, 3.125rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .bio {
    margin-top: 2rem;
    line-height: 1.65;
  }
  .bio p {
    margin-bottom: 1.1em;
  }

  .media-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.25rem;
    margin: 2rem 0 2.25rem;
  }
  .snapshot {
    margin: 0;
    padding: 0;
    flex: 1 1 260px;
    max-width: 420px;
  }
  .snapshot__img {
    display: block;
    width: 100%;
    height: auto;
  }
  .panel-caption {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-ink);
    padding: 0.5rem 0.75rem;
    border-top: 1px solid var(--rule);
    background: var(--paper-2);
  }

  /* ---- previously ---------------------------------------------------- */
  .sprite {
    position: relative;
    margin: 0;
    padding: 0;
    flex: 0 0 auto;
    width: 132px;
  }
  /* the credit stays out of the way until the sprite is hovered or focused */
  .sprite__credit {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    width: max-content;
    max-width: 230px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.4;
    color: var(--muted-ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity 140ms ease;
  }
  .sprite:hover .sprite__credit,
  .sprite:focus-within .sprite__credit {
    opacity: 1;
    pointer-events: auto;
  }
  .sprite__credit a {
    color: inherit;
    border-bottom: 1px solid var(--rule);
  }
  .sprite__credit a:hover {
    color: hsl(var(--accent-foreground));
    background: hsl(var(--selection));
    border-bottom-color: hsl(var(--accent-foreground));
  }
  .sprite__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .previously {
    padding-bottom: 3rem;
    max-width: 720px;
  }
  .previously__body {
    margin: 1rem 0 0;
    color: var(--muted-ink);
  }

  /* ---- tabs ---------------------------------------------------------- */
  .page {
    padding-bottom: 2rem;
    max-width: 720px;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border: 1px solid var(--ink);
    border-bottom: 0;
    width: fit-content;
    max-width: 100%;
  }
  .tab {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: lowercase;
    color: var(--muted-ink);
    padding: 0.5rem 1rem;
    border-right: 1px solid var(--rule);
    transition: background-color 120ms ease, color 120ms ease;
  }
  .tab:last-child {
    border-right: 0;
  }
  .tab:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  .tab.is-active {
    color: hsl(var(--accent-foreground));
    background: hsl(var(--accent));
  }

  /* ---- entry rows ---------------------------------------------------- */
  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry + .entry {
    border-top: 1px solid var(--rule);
  }
  .entry__link {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    padding: 1rem;
    border-bottom: 0;
    transition: background-color 120ms ease;
  }
  a.entry__link:hover {
    background: var(--paper-2);
    color: inherit;
  }
  .entry__body {
    flex: 1;
    min-width: 0;
  }
  .entry__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .entry__title {
    font-size: var(--step-0);
    font-weight: 600;
    text-transform: none;
    overflow-wrap: anywhere;
  }
  .entry__sep,
  .entry__sub {
    font-weight: 400;
    color: var(--muted-ink);
  }
  .entry__title-link {
    border-bottom: 0;
  }
  .entry__title-link:hover {
    background: none;
    color: hsl(var(--accent-foreground));
  }
  .entry__aside {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--muted-ink);
  }
  .entry__meta {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .entry__arrow--hidden {
    visibility: hidden;
  }
  a.entry__link:hover .entry__arrow,
  .entry__title-link:hover + .entry__aside .entry__arrow {
    color: hsl(var(--accent-foreground));
  }
  .entry__blurb {
    margin: 0.375rem 0 0;
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--muted-ink);
    max-width: var(--measure);
  }
  .entry__blog-btn {
    display: inline-block;
    margin: 0.625rem 0.5rem 0 0;
    padding: 0.1875rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--muted-ink);
    border: 1px solid var(--rule);
  }
  .entry__blog-btn:hover {
    color: hsl(var(--accent-foreground));
    background: hsl(var(--selection));
    border-color: hsl(var(--accent-foreground));
  }

  /* ---- gallery ------------------------------------------------------- */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
  }
  .grid__cell--empty {
    aspect-ratio: 4 / 3;
    border: 1px dashed var(--rule);
    background-image: url('/dotted.svg');
    opacity: 0.25;
  }
  .grid__btn {
    display: block;
    padding: 0;
    width: 100%;
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .grid__img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .grid__btn:hover .grid__img {
    opacity: 0.85;
  }

  /* ---- lightbox ------------------------------------------------------ */
  .lightbox {
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0;
    max-width: min(92vw, 1000px);
    max-height: 90vh;
  }
  .lightbox::backdrop {
    background: hsl(var(--foreground) / 0.6);
    backdrop-filter: blur(3px);
  }
  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }
  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    font-family: var(--font-mono);
    line-height: 1;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--ink);
    width: 2rem;
    height: 2rem;
  }
  .lightbox__close {
    top: 0.5rem;
    right: 0.5rem;
    font-size: 1.125rem;
  }
  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.25rem;
  }
  .lightbox__nav--prev { left: 0.5rem; }
  .lightbox__nav--next { right: 0.5rem; }
  .lightbox__close:hover,
  .lightbox__nav:hover {
    color: hsl(var(--accent-foreground));
    background: hsl(var(--accent));
  }

  @media (max-width: 36rem) {
    .entry__head {
      flex-direction: column;
      gap: 0.25rem;
    }
    .entry__link {
      padding: 0.875rem;
    }
    .tabs {
      width: 100%;
    }
    .tab {
      flex: 1 1 0;
      min-width: 0;
      text-align: center;
      font-size: var(--step--2);
      padding-inline: 0.25rem;
    }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

  function select(name: string, focus = false) {
    tabs.forEach((tab) => {
      const active = tab.dataset.tab === name;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && focus) tab.focus();
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== name;
    });
    history.replaceState(null, '', name === 'work' ? location.pathname : `#${name}`);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => select(tab.dataset.tab!));
    tab.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(tab);
      let next = -1;
      if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      if (e.key === 'Home') next = 0;
      if (e.key === 'End') next = tabs.length - 1;
      if (next < 0) return;
      e.preventDefault();
      select(tabs[next].dataset.tab!, true);
    });
  });

  const initial = location.hash.slice(1);
  if (tabs.some((t) => t.dataset.tab === initial)) select(initial);

  const photos = Array.from(document.querySelectorAll<HTMLImageElement>('.grid__img'));
  const lightbox = document.querySelector<HTMLDialogElement>('#lightbox');
  const lightboxImg = document.querySelector<HTMLImageElement>('#lightbox-img');

  if (lightbox && lightboxImg && photos.length) {
    const navs = Array.from(lightbox.querySelectorAll<HTMLButtonElement>('.lightbox__nav'));
    let current = 0;

    function show(i: number) {
      current = (i + photos.length) % photos.length;
      const photo = photos[current];
      lightboxImg!.src = photo.currentSrc || photo.src;
      lightboxImg!.alt = photo.alt;
      navs.forEach((nav) => { nav.hidden = photos.length < 2; });
    }

    document.querySelectorAll<HTMLButtonElement>('.grid__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.photo));
        lightbox.showModal();
      });
    });

    navs.forEach((nav) => {
      nav.addEventListener('click', (e) => {
        e.stopPropagation();
        show(current + Number(nav.dataset.step));
      });
    });

    lightbox.querySelector<HTMLButtonElement>('[data-close]')?.addEventListener('click', () => lightbox.close());

    // Click anywhere outside the image closes.
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === lightboxImg) lightbox.close();
    });

    lightbox.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
    });

    lightbox.addEventListener('close', () => { lightboxImg.src = ''; });
  }
</script>
