---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'home' },
  { href: '/tennis', label: 'tennis' },
  { href: 'https://github.com/ethanwfang', label: 'github', external: true },
];
---

<header class="nav">
  <div class="nav__inner">
    <a class="nav__brand" href="/">ethan fang</a>
    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class="nav__link"
          aria-current={!l.external && pathname.replace(/\/$/, '') === l.href.replace(/\/$/, '') ? 'page' : undefined}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener noreferrer' : undefined}
        >
          {l.label}{l.external && <span aria-hidden="true"> &#8599;</span>}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: hsl(var(--background) / 0.85);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule);
  }
  .nav__inner {
    width: min(100% - 2rem, 880px);
    margin-inline: auto;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .nav__brand,
  .nav__link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    border-bottom: 0;
  }
  .nav__brand {
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .nav__links {
    display: flex;
    gap: 1.25rem;
  }
  .nav__link {
    color: var(--muted-ink);
    padding-block: 0.125rem;
  }
  .nav__link:hover {
    background: none;
    color: var(--ink);
  }
  .nav__link[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 hsl(var(--accent));
  }
</style>
